# Automatically generated using: hell submit ... (reference copy made by python/hell/batch/condor.py)
# HELL condor submit file
universe   = vanilla
executable = <taskdir>/job.sh
arguments  = $(jobid)
output     = <taskdir>/logs/$(jobid).out
error      = <taskdir>/logs/$(jobid).err
log        = <taskdir>/logs/condor.log
+JobFlavour = "workday"
request_cpus = 1
request_memory = 2000MB

getenv = False
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = <taskdir>/hell.tar.gz, <taskdir>/jobs.json[, <taskdir>/<Golden JSON>]
transfer_output_files = ""
max_retries = 2
requirements = Machine =!= LastRemoteHost
queue jobid from <taskdir>/jobs.txt
